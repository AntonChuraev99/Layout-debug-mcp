* text=auto eol=lf
# Scripts with a shebang must keep LF on every checkout (Linux/macOS run them directly).
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.png binary
*.jpg binary
# Android build (android/): the Gradle wrapper scripts and jar.
gradlew text eol=lf
*.bat text eol=crlf
*.jar binary
